+def rollout_gap_parts(
+    train_logprobs: torch.Tensor, rollout_logprobs: torch.Tensor, loss_mask: torch.Tensor
+) -> Tuple[float, float]:
+    """Sum and count of |train - rollout| logprob over response tokens.
+
+    Reported as two parts so that averaging each over ranks and micro-batches, as the metric path
+    does, and dividing gives the token-weighted mean over the whole batch.
+
+    Args:
+        train_logprobs: Logprobs from the training forward.
+        rollout_logprobs: Logprobs vLLM sampled with.
+        loss_mask: 1 on response tokens.
+
+    Returns:
+        The summed absolute gap and the number of response tokens.
+    """
+    response = loss_mask > 0
+    gap = (train_logprobs.detach().float() - rollout_logprobs.float())[response].abs()
+    return gap.sum().item(), float(gap.numel())
