diff --git a/skyrl-train/skyrl_train/utils/balance.py b/skyrl-train/skyrl_train/utils/balance.py
new file mode 100644
index 00000000..842fb45d
--- /dev/null
+++ b/skyrl-train/skyrl_train/utils/balance.py
@@ -0,0 +1,105 @@
+"""Token-balanced assignment of rollouts to data-parallel ranks.
+
+SkyRL hands each DP rank a **contiguous** slice of the batch (``MeshDispatch.dispatch`` ->
+``TensorBatch.chunk``), and rollouts are laid out prompt-major, so a rank's rows come from one
+or a few prompt groups and its work tracks those prompts' lengths. Every rank must finish
+before the optimizer step, so with skewed prompt lengths a step costs the **max** rank load
+where the ideal is the **mean**. When ``train_batch_size == dp_size`` each rank holds exactly
+one group and permuting whole *groups* cannot help, so balancing happens at the **rollout**
+level and a rank's rows come from several different prompts.
+
+**Why that is legal.** Advantages are computed per row before dispatch, and under
+``seq_mean_token_sum_norm`` (Dr. GRPO) each sequence's loss is normalised by a *constant*
+``max_seq_len`` and then averaged over the rank's rows. With an equal row count per rank,
+the mean-over-ranks of that quantity equals the global mean regardless of which rank holds
+which row -- so the gradient is exactly permutation-invariant. ``sequence_mean`` shares that
+property. ``token_mean`` does **not**: it divides by the rank's own token count, so moving
+rows between ranks reweights the objective. Callers must refuse to balance in that mode.
+"""
+
+from __future__ import annotations
+
+import heapq
+from collections.abc import Sequence
+
+__all__ = ["balanced_dp_order", "imbalance_ratio"]
+
+# Loss reductions whose gradient is invariant to which rank holds which row, given an equal
+# row count per rank. `token_mean` normalises by the rank's own token count and is excluded.
+PERMUTATION_INVARIANT_REDUCTIONS = frozenset({"seq_mean_token_sum_norm", "sequence_mean"})
+
+
+def balanced_dp_order(lengths: Sequence[int], dp_size: int) -> list[int]:
+    """Order rows so equal-size contiguous chunks carry similar total token counts.
+
+    Longest-processing-time-first with a hard cardinality cap: rows are placed longest
+    first into whichever rank is currently lightest and not yet full. The cap is what keeps
+    this safe — every rank must receive exactly ``len(lengths) // dp_size`` rows, because
+    gradient accumulation derives its step count from the configured batch sizes and a rank
+    with fewer rows would silently never complete a mini-batch.
+
+    Args:
+        lengths: Per-row token counts, in the batch's current row order.
+        dp_size: Number of data-parallel ranks.
+
+    Returns:
+        A permutation of ``range(len(lengths))``. Rows ``[k*per, (k+1)*per)`` of the result
+        belong to rank ``k``, matching how ``TensorBatch.chunk`` slices the batch.
+
+    Raises:
+        ValueError: ``dp_size`` is not positive, or does not divide the row count.
+    """
+    total = len(lengths)
+    if dp_size <= 0:
+        raise ValueError(f"dp_size must be positive, got {dp_size}")
+    if total % dp_size != 0:
+        raise ValueError(f"row count {total} is not divisible by dp_size {dp_size}")
+    if dp_size == 1 or total == 0:
+        return list(range(total))
+
+    per_rank = total // dp_size
+    # Longest first. Ties broken by index so the result is deterministic across ranks --
+    # every rank computes this independently and they MUST agree.
+    order = sorted(range(total), key=lambda i: (-lengths[i], i))
+
+    bins: list[list[int]] = [[] for _ in range(dp_size)]
+    # (current load, rank). A rank that reaches `per_rank` rows is simply never pushed back,
+    # so it drops out of consideration permanently.
+    heap = [(0, rank) for rank in range(dp_size)]
+    heapq.heapify(heap)
+
+    for row in order:
+        load, rank = heapq.heappop(heap)
+        bins[rank].append(row)
+        if len(bins[rank]) < per_rank:
+            heapq.heappush(heap, (load + lengths[row], rank))
+
+    return [row for bin_rows in bins for row in bin_rows]
+
+
+def imbalance_ratio(lengths: Sequence[int], dp_size: int, order: Sequence[int] | None = None) -> float:
+    """Ratio of the slowest rank's load to the mean — the factor a step is inflated by.
+
+    Args:
+        lengths: Per-row token counts, in the batch's current row order.
+        dp_size: Number of data-parallel ranks.
+        order: Row order to evaluate; defaults to the batch's existing order.
+
+    Returns:
+        ``max_rank_load / mean_rank_load``. 1.0 is perfectly balanced. Returns 1.0 when
+        every rank has zero load, since there is nothing to wait for.
+
+    Raises:
+        ValueError: ``dp_size`` does not divide the row count.
+    """
+    total = len(lengths)
+    if total % dp_size != 0:
+        raise ValueError(f"row count {total} is not divisible by dp_size {dp_size}")
+    if total == 0:
+        return 1.0
+
+    rows = list(range(total)) if order is None else list(order)
+    per_rank = total // dp_size
+    loads = [sum(lengths[r] for r in rows[k * per_rank : (k + 1) * per_rank]) for k in range(dp_size)]
+    mean = sum(loads) / dp_size
+    return (max(loads) / mean) if mean > 0 else 1.0
diff --git a/skyrl-train/skyrl_train/utils/checkpoint_integrity.py b/skyrl-train/skyrl_train/utils/checkpoint_integrity.py
new file mode 100644
index 00000000..8a96ebfc
--- /dev/null
+++ b/skyrl-train/skyrl_train/utils/checkpoint_integrity.py
@@ -0,0 +1,134 @@
+"""Detect checkpoints whose per-rank shards did not all reach disk.
+
+Writing ``latest_ckpt_global_step.txt`` after the saves is necessary and **not sufficient** when the
+writers are N independent ranks on M nodes that can die at different instants: under a walltime
+kill the driver can outlive some nodes, advertise a step whose shards are only partly on disk, and
+then prune the last good checkpoint, leaving the run unable to resume.
+
+The invariant: a checkpoint directory counts as complete only when every rank
+``0..world_size-1`` has written both its model shard and its extra_state shard. The world size is
+read from the filenames themselves (``model_world_size_32_rank_7.pt``) rather than from config, so
+this cannot drift out of step with the launcher and needs no knowledge of the placement.
+
+Why extra_state too: each rank writes model, then optim, then extra_state, and the loader needs
+model and extra_state, so a save cut off after the model shards would otherwise pass and then fail
+on resume (``Extra state checkpoint not found``).
+
+Used on BOTH sides, because either alone leaves a hole:
+
+* **write side** -- refuse to advertise (and refuse to prune) an incomplete save, so a dying job
+  cannot destroy a good checkpoint on its way out;
+* **read side** -- resume from the newest COMPLETE step rather than trusting the marker, which
+  also covers directories written without the write-side guard.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+
+# `model_world_size_{world_size}_rank_{rank}.pt`, written per rank by the FSDP policy worker.
+_SHARD_RE = re.compile(r"^model_world_size_(\d+)_rank_(\d+)\.pt$")
+# A rank's last write, after its model and optim shards; the loader requires it.
+_EXTRA_RE = re.compile(r"^extra_state_world_size_(\d+)_rank_(\d+)\.pt$")
+
+GLOBAL_STEP_PREFIX = "global_step_"
+
+
+def scan_policy_shards(policy_dir: str) -> tuple[int | None, set[int]]:
+    """Read the world size and the set of ranks that finished writing their shards.
+
+    Args:
+        policy_dir: The ``policy/`` directory inside a ``global_step_N`` checkpoint.
+
+    Returns:
+        ``(world_size, present_ranks)``, where a rank is present when both its model shard and its
+        extra_state shard are on disk at that world size. ``world_size`` is ``None`` when the
+        directory holds no recognisable model shards. If shards disagree about the world size --
+        which would mean two different runs wrote into one directory -- the LARGEST is returned, so
+        the completeness check below fails rather than passing on a partial match.
+    """
+    try:
+        names = os.listdir(policy_dir)
+    except (FileNotFoundError, NotADirectoryError, PermissionError):
+        return None, set()
+
+    sizes: set[int] = set()
+    model: set[tuple[int, int]] = set()
+    extra: set[tuple[int, int]] = set()
+    for name in names:
+        if match := _SHARD_RE.match(name):
+            sizes.add(int(match.group(1)))
+            model.add((int(match.group(1)), int(match.group(2))))
+        elif match := _EXTRA_RE.match(name):
