+        degenerate = 0
+        for values in groups.values():
+            if len(values) < 2:
+                continue
+            mean = sum(values) / len(values)
+            std = (sum((v - mean) ** 2 for v in values) / len(values)) ** 0.5
+            stds.append(std)
+            spans.append(max(values) - min(values))
+            maxes.append(max(values))
+            mins.append(min(values))
+            # Zero spread => zero advantage for every sample of this prompt => no gradient.
+            if std == 0.0:
+                degenerate += 1
+
+        if not stds:
+            return {}
+
+        # The reward distribution over each prompt's rollouts goes under `reward/`, beside
+        # `reward/avg_raw_reward`; algorithm health stays under `grpo/`.
+        n_groups = len(stds)
+        return {
