+def _should_use_meta_init(model_config) -> bool:
+    """Whether to build the model with meta-device init on non-zero ranks.
+
+    Meta init is asymmetric: rank 0 builds the real model on CPU while every other rank
+    builds on meta and is filled by broadcast. If the two paths produce even slightly
+    different module graphs -- a tied-weight difference, a custom architecture whose
+    `from_pretrained` behaves differently under `init_empty_weights` -- the ranks issue
+    different sequences of collectives and FSDP deadlocks.
+
+    Set ``SKYRL_DISABLE_META_INIT=1`` to make every rank load real weights on CPU, so the
+    module graph is identical by construction, at a cost of ``world_size x model_size`` of
+    host RAM.
+
+    Args:
+        model_config: The HF config of the model being built.
+
+    Returns:
+        Whether meta-device init should be used.
+    """
+    if os.environ.get("SKYRL_DISABLE_META_INIT", "0") == "1":
+        return False
+    return not model_config.tie_word_embeddings
+
