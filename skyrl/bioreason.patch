+    def _shift_modalities_metadata_for_padding(
+        self,
+        *,
+        sequences: torch.Tensor,
+        attention_mask: torch.Tensor,
+        num_actions: Union[int, list[int]],
+        modalities_metadata: Optional[List[SampleModalityData]],
