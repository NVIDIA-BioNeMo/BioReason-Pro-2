+            "reward/group_span": sum(spans) / n_groups,
+            "reward/group_max": sum(maxes) / n_groups,
+            "reward/group_min": sum(mins) / n_groups,
+            # At 1.0 the batch produces no gradient whatsoever.
+            "grpo/zero_variance_group_frac": degenerate / n_groups,
+            "grpo/num_groups": float(n_groups),
+        }
