@@ -0,0 +1,163 @@
+"""Three Qwen3.5 failures that would not raise on their own, pinned through the real entry points.
+
+* Packing several rollouts into one row runs Qwen3.5's gated delta net across the boundaries, so
+  training logprobs stop matching what vLLM sampled.
+* A checkpoint missing decoder-layer weights loads with those weights at random init.
+* ``language_model_only`` silently sets every multimodal limit, the protein span's included, to 0.
+"""
+
+from __future__ import annotations
+
+import pytest
+import torch
+from safetensors.torch import load_file, save_file
+from transformers import Qwen3_5ForCausalLM, Qwen3_5TextConfig
+
+from skyrl_train import model_wrapper
+from skyrl_train.inference_engines.vllm.vllm_engine import _maybe_setup_mm
+from skyrl_train.model_wrapper import HFModelWrapper
+from skyrl_train.utils.torch_utils import logprobs_from_logits_v2
+
+LINEAR = "linear_attention"
+FULL = "full_attention"
+
+pytestmark = pytest.mark.usefixtures("torch_gdn")
+
+
+def tiny_qwen35(layer_types: list[str], tie: bool = True, seed: int = 0) -> Qwen3_5ForCausalLM:
+    """A Qwen3.5 text model small enough for CPU, with the real hybrid layer classes.
+
+    Args:
+        layer_types: One entry per layer, ``linear_attention`` or ``full_attention``.
+        tie: Whether ``lm_head`` shares the input embedding, as in the published 4B.
+        seed: Initialisation seed.
+
+    Returns:
+        The model in eval mode.
+    """
+    torch.manual_seed(seed)
+    config = Qwen3_5TextConfig(
+        vocab_size=64,
+        hidden_size=32,
+        intermediate_size=64,
+        num_hidden_layers=len(layer_types),
+        num_attention_heads=2,
+        num_key_value_heads=1,
+        head_dim=16,
+        linear_num_key_heads=2,
+        linear_num_value_heads=2,
+        linear_key_head_dim=8,
+        linear_value_head_dim=8,
+        layer_types=layer_types,
+        tie_word_embeddings=tie,
+    )
+    return Qwen3_5ForCausalLM(config).eval()
+
+
+def save_checkpoint(model: Qwen3_5ForCausalLM, path, drop: str | None = None) -> None:
+    """Write ``model`` with ``save_pretrained``, optionally with one weight left out.
+
+    Args:
+        model: Source model.
+        path: Directory to write the config and ``model.safetensors`` into.
+        drop: The key suffix of a weight to omit (e.g. ``layers.0.mlp.up_proj.weight``), matched by
+            suffix because transformers may write the decoder under a different prefix on disk.
+    """
+    model.save_pretrained(path)
+    if drop is not None:
+        weights = path / "model.safetensors"
+        tensors = load_file(str(weights))
+        matches = [key for key in tensors if key.endswith("." + drop)]
+        assert len(matches) == 1, matches
+        del tensors[matches[0]]
+        save_file(tensors, str(weights), metadata={"format": "pt"})
+
+
+def test_packing_leaks_gated_delta_state_across_rollouts() -> None:
+    """The hazard the guard exists for: a packed neighbour changes a rollout's logits.
+
+    Linear-attention layers take no position input, so reset position_ids cannot separate the two
+    sequences -- the second is scored on state the first left behind. All-linear layers keep
+    attention, which a packed eager row would also leak through, out of the comparison.
+    ``use_cache=False`` because HF's cache cannot report a length without an attention layer.
+    """
+    model = tiny_qwen35([LINEAR, LINEAR])
+    first, second = torch.randint(0, 64, (1, 5)), torch.randint(0, 64, (1, 7))
+    with torch.no_grad():
+        alone = model(second, use_cache=False).logits
+        packed_ids = torch.cat([first, second], dim=1)
+        positions = torch.cat([torch.arange(5), torch.arange(7)]).unsqueeze(0)
+        packed = model(packed_ids, position_ids=positions, use_cache=False).logits[:, 5:]
+    assert not torch.allclose(alone, packed, atol=1e-4)
+
+
+def test_packed_multi_rollout_forward_is_refused(monkeypatch) -> None:
+    """Two rollouts in one packed micro-batch on a hybrid model must raise, not score."""
+    monkeypatch.setattr(
+        model_wrapper, "logprobs_from_logits", lambda logits, labels, **_: logprobs_from_logits_v2(logits, labels)
+    )
+    wrapper = HFModelWrapper(tiny_qwen35([LINEAR, FULL]), use_flash_attention_2=True, use_sample_packing=True)
+    sequences = torch.randint(0, 64, (2, 6))
+    with pytest.raises(ValueError, match="linear-attention or Mamba"):
+        wrapper(sequences, num_actions=2, attention_mask=torch.ones_like(sequences))
+
+
+def test_packed_single_rollout_forward_still_scores(monkeypatch) -> None:
+    """The control: one rollout per micro-batch, which every RL run uses, is untouched."""
+    monkeypatch.setattr(
+        model_wrapper, "logprobs_from_logits", lambda logits, labels, **_: logprobs_from_logits_v2(logits, labels)
+    )
+    wrapper = HFModelWrapper(tiny_qwen35([LINEAR, FULL]), use_flash_attention_2=True, use_sample_packing=True)
+    sequences = torch.randint(0, 64, (1, 6))
+    with torch.no_grad():
+        logprobs = wrapper(sequences, num_actions=2, attention_mask=torch.ones_like(sequences))
+    assert logprobs.shape == (1, 2)
+    assert torch.isfinite(logprobs).all()
+
+
+@pytest.mark.parametrize("tie", [True, False])
+def test_complete_checkpoint_loads_every_weight(tmp_path, tie: bool) -> None:
+    """A complete checkpoint, tied (4B) or untied (9B), loads through the wrapper exactly."""
+    source = tiny_qwen35([LINEAR, FULL], tie=tie, seed=0)
+    save_checkpoint(source, tmp_path)
+    loaded = HFModelWrapper(str(tmp_path), bf16=False).model.state_dict()
+    for name, want in source.state_dict().items():
+        assert torch.equal(want, loaded[name]), name
+
+
+@pytest.mark.parametrize(
+    "drop",
+    [
+        "layers.0.linear_attn.in_proj_qkv.weight",
+        "layers.1.self_attn.q_proj.weight",
+        "layers.0.mlp.up_proj.weight",
+    ],
+)
+def test_missing_decoder_weight_is_refused(tmp_path, drop: str) -> None:
+    """A hole in the checkpoint must raise; from_pretrained alone would leave that tensor at random init."""
+    save_checkpoint(tiny_qwen35([LINEAR, FULL], seed=0), tmp_path, drop=drop)
+    with pytest.raises(RuntimeError, match="decoder-layer weights"):
+        HFModelWrapper(str(tmp_path), bf16=False)
+
+
+def test_language_model_only_is_refused_on_the_multimodal_path(monkeypatch) -> None:
+    """With a modality configured, ``language_model_only`` would zero its limit; refuse it."""
+    monkeypatch.setenv("SKYRL_MM_MODALITY", "protein")
+    with pytest.raises(ValueError, match="language_model_only"):
+        _maybe_setup_mm({"language_model_only": True})
+
+
+def test_multimodal_path_sets_its_own_limit(monkeypatch) -> None:
+    """Without the flag the multimodal path still gets its one-span limit and embeds input."""
+    monkeypatch.setenv("SKYRL_MM_MODALITY", "protein")
+    kwargs: dict = {}
+    _maybe_setup_mm(kwargs)
+    assert kwargs == {"enable_mm_embeds": True, "limit_mm_per_prompt": {"protein": 1}}
+
+
+def test_language_model_only_stays_allowed_without_a_modality(monkeypatch) -> None:
+    """Without SKYRL_MM_MODALITY (text-only generation) the flag still skips the vision tower."""
+    monkeypatch.delenv("SKYRL_MM_MODALITY", raising=False)
+    kwargs = {"language_model_only": True}
+    _maybe_setup_mm(kwargs)
+    assert kwargs == {"language_model_only": True}
diff --git a/skyrl-train/tests/cpu/models/test_response_logits_only.py b/skyrl-train/tests/cpu/models/test_response_logits_only.py
new file mode 100644
index 00000000..7ea95af9
--- /dev/null
+++ b/skyrl-train/tests/cpu/models/test_response_logits_only.py
@@ -0,0 +1,155 @@
+"""Response-only logits give the same response logprobs, entropy and gradients as full logits.
+
+`SKYRL_RESPONSE_LOGITS_ONLY` builds the lm_head output only at the positions that predict a
+response token. These tests drive the real `HFModelWrapper.forward` on a tiny hybrid Qwen3.5 both
+ways, in the packed single-sequence shape every RL run uses and in the padded batch shape, including
+a row shorter than the kept window and right-padded responses, and require the response-side
+outputs and every parameter gradient to agree. They also pin that the window is not used where it
+would be wrong: several sequences packed into one row.
+"""
+
+from __future__ import annotations
+
+import pytest
+import torch
+from transformers import LlamaConfig, LlamaForCausalLM, Qwen3_5ForCausalLM, Qwen3_5TextConfig
+
+from skyrl_train import model_wrapper
+from skyrl_train.model_wrapper import HFModelWrapper
+from skyrl_train.utils.torch_utils import logprobs_from_logits_v2
+
+pytestmark = pytest.mark.usefixtures("torch_gdn")
+
+
+@pytest.fixture(autouse=True)
+def cpu_logprobs(monkeypatch) -> None:
+    """The flash-attn cross-entropy kernel needs a GPU; the reference log-softmax is the same math."""
+    monkeypatch.setattr(
+        model_wrapper, "logprobs_from_logits", lambda logits, labels, **_: logprobs_from_logits_v2(logits, labels)
+    )
+
+
+def tiny_qwen35() -> Qwen3_5ForCausalLM:
+    """A CPU-sized Qwen3.5 with one gated-delta-net and one attention layer, untied head."""
+    torch.manual_seed(0)
+    config = Qwen3_5TextConfig(
+        vocab_size=97,
+        hidden_size=32,
+        intermediate_size=64,
+        num_hidden_layers=2,
+        num_attention_heads=2,
+        num_key_value_heads=1,
+        head_dim=16,
+        linear_num_key_heads=2,
+        linear_num_value_heads=2,
+        linear_key_head_dim=8,
+        linear_value_head_dim=8,
+        layer_types=["linear_attention", "full_attention"],
+        tie_word_embeddings=False,
+    )
+    return Qwen3_5ForCausalLM(config).float()
+
+
+def batch(prompt_valid: list[int], response_valid: list[int], prompt_slots: int, num_actions: int):
+    """A left-padded prompt + right-padded response batch, as SkyRL lays it out.
+
+    Args:
+        prompt_valid: Real prompt tokens per row.
+        response_valid: Real response tokens per row.
+        prompt_slots: Padded prompt width.
+        num_actions: Padded response width.
+
+    Returns:
+        sequences, attention_mask, loss_mask.
+    """
+    rows = len(prompt_valid)
+    sequences = torch.randint(1, 97, (rows, prompt_slots + num_actions), generator=torch.Generator().manual_seed(3))
+    attention_mask = torch.zeros_like(sequences)
+    loss_mask = torch.zeros(rows, num_actions)
+    for row, (p, r) in enumerate(zip(prompt_valid, response_valid)):
+        attention_mask[row, prompt_slots - p : prompt_slots + r] = 1
+        loss_mask[row, :r] = 1
+    return sequences * attention_mask, attention_mask, loss_mask
+
+
+def run(wrapper: HFModelWrapper, keep: bool, sequences, attention_mask, loss_mask, num_actions: int):
+    """One forward + backward of the masked response logprob sum; returns outputs and grads.
+
+    Also checks the window actually reached the model, so a switch that never fires cannot pass as
+    full-against-full.
+    """
+    wrapper.response_logits_only = keep
+    wrapper.zero_grad()
+    seen = []
+    forward = wrapper.model.forward
+    wrapper.model.forward = lambda *args, **kwargs: seen.append(kwargs.get("logits_to_keep")) or forward(
+        *args, **kwargs
+    )
+    try:
+        logprobs, output = wrapper(
+            sequences, num_actions, attention_mask=attention_mask, return_output=True, compute_entropy=True
+        )
+    finally:
+        del wrapper.model.forward
+    assert seen == [num_actions + 1 if keep else None]
+    (logprobs * loss_mask).sum().backward()
+    entropy = output["entropy"][:, -num_actions - 1 : -1] * loss_mask
+    grads = {name: p.grad.clone() for name, p in wrapper.model.named_parameters() if p.grad is not None}
+    return (logprobs * loss_mask).detach(), entropy.detach(), grads
+
+
+def assert_same(full, kept) -> None:
+    """Response logprobs, entropy and every gradient agree between the two paths."""
+    assert torch.allclose(full[0], kept[0], atol=1e-5), (full[0] - kept[0]).abs().max()
+    assert torch.allclose(full[1], kept[1], atol=1e-5), (full[1] - kept[1]).abs().max()
+    assert full[2].keys() == kept[2].keys()
+    for name in full[2]:
+        assert torch.allclose(full[2][name], kept[2][name], atol=1e-5), name
+
+
+@pytest.mark.parametrize(
+    "prompt_valid, response_valid",
+    [
+        ([7], [6]),  # full-width response: the first response token needs the window's +1
+        ([7], [2]),  # short response: the window reaches back into the prompt
+        ([2], [1]),  # row shorter than the window: HF returns every position
+    ],
+)
+def test_packed_single_sequence_matches(prompt_valid, response_valid) -> None:
+    """The RL shape: micro batch 1, packed."""
+    wrapper = HFModelWrapper(tiny_qwen35(), use_flash_attention_2=True, use_sample_packing=True)
+    data = batch(prompt_valid, response_valid, prompt_slots=8, num_actions=6)
+    assert_same(run(wrapper, False, *data, 6), run(wrapper, True, *data, 6))
+
+
+def test_padded_batch_matches() -> None:
+    """Unpacked, several rows of different lengths."""
+    wrapper = HFModelWrapper(tiny_qwen35(), use_sample_packing=False)
+    data = batch([7, 3, 5], [6, 2, 4], prompt_slots=8, num_actions=6)
+    assert_same(run(wrapper, False, *data, 6), run(wrapper, True, *data, 6))
+
+
+def test_env_switch_is_read(monkeypatch) -> None:
+    """The launcher's SKYRL_RESPONSE_LOGITS_ONLY=1 is what turns the window on; unset leaves it off."""
+    monkeypatch.setenv("SKYRL_RESPONSE_LOGITS_ONLY", "1")
+    assert HFModelWrapper(tiny_qwen35(), use_sample_packing=False).response_logits_only
+    monkeypatch.delenv("SKYRL_RESPONSE_LOGITS_ONLY")
+    assert not HFModelWrapper(tiny_qwen35(), use_sample_packing=False).response_logits_only
+
+
+def test_several_packed_sequences_build_full_logits() -> None:
+    """With several sequences in one packed row the response positions are not the row's last ones."""
+    torch.manual_seed(0)
+    dense = LlamaForCausalLM(
+        LlamaConfig(vocab_size=97, hidden_size=32, intermediate_size=64, num_hidden_layers=1, num_attention_heads=2)
+    )
+    wrapper = HFModelWrapper(dense, use_flash_attention_2=True, use_sample_packing=True)
+    seen = []
+    forward = wrapper.model.forward
+    wrapper.model.forward = lambda *args, **kwargs: seen.append(kwargs.get("logits_to_keep")) or forward(
+        *args, **kwargs
+    )
+    wrapper.response_logits_only = True
+    sequences, attention_mask, _ = batch([7, 3], [6, 2], prompt_slots=8, num_actions=6)
+    wrapper(sequences, 6, attention_mask=attention_mask)
+    assert seen == [None]
diff --git a/skyrl-train/tests/cpu/test_checkpoint_integrity.py b/skyrl-train/tests/cpu/test_checkpoint_integrity.py
new file mode 100644
index 00000000..f855975b
--- /dev/null
+++ b/skyrl-train/tests/cpu/test_checkpoint_integrity.py
@@ -0,0 +1,90 @@
+"""A checkpoint counts as complete only when every rank wrote its model AND extra_state shards.
+
+Covers the two partial-save shapes a walltime kill leaves: whole nodes' ranks missing, and every
+model shard on disk but only some extra_state shards.
+"""
+
+from __future__ import annotations
+
+import os
+
+from skyrl_train.utils.checkpoint_integrity import (
+    describe,
+    is_complete,
+    missing_ranks,
+    newest_complete_step,
+    scan_policy_shards,
+)
+
+
+def write_ckpt(root, step: int, world_size: int, ranks, extra=None) -> str:
+    """Create global_step_N/policy with model shards for `ranks` and extra_state for `extra` (default: the same).
+
+    Args:
+        root: Checkpoint root.
+        step: Global step.
+        world_size: World size in the shard names.
+        ranks: Ranks with a model shard.
+        extra: Ranks with an extra_state shard; None means the same as `ranks`.
+
+    Returns:
+        The global_step_N directory.
+    """
+    policy = os.path.join(root, f"global_step_{step}", "policy")
+    os.makedirs(policy, exist_ok=True)
+    for r in ranks:
+        open(os.path.join(policy, f"model_world_size_{world_size}_rank_{r}.pt"), "wb").close()
+    for r in ranks if extra is None else extra:
+        open(os.path.join(policy, f"extra_state_world_size_{world_size}_rank_{r}.pt"), "wb").close()
+    return os.path.dirname(policy)
+
+
+def test_complete_checkpoint(tmp_path) -> None:
+    d = write_ckpt(tmp_path, 10, 8, range(8))
+    assert is_complete(d) and missing_ranks(d) == []
+    assert "complete (8/8 ranks)" in describe(d)
+
+
+def test_missing_nodes_are_incomplete(tmp_path) -> None:
+    d = write_ckpt(tmp_path, 90, 32, list(range(8)) + list(range(24, 32)))
+    assert not is_complete(d)
+    assert missing_ranks(d) == list(range(8, 24))
+
+
+def test_model_shards_without_extra_state_are_incomplete(tmp_path) -> None:
+    """All model shards, extra_state for 24 of 32: the walltime-mid-save shape model shards alone passed."""
+    good = write_ckpt(tmp_path, 430, 32, range(32))
+    partial = write_ckpt(tmp_path, 435, 32, range(32), extra=range(24))
+    assert not is_complete(partial)
+    assert missing_ranks(partial) == list(range(24, 32))
+    assert "INCOMPLETE 24/32" in describe(partial)
+    assert is_complete(good)
+    assert newest_complete_step(str(tmp_path), at_most=435) == 430
+
+
+def test_extra_state_from_another_world_size_does_not_count(tmp_path) -> None:
+    d = write_ckpt(tmp_path, 10, 8, range(8), extra=[])
+    for r in range(8):
+        open(os.path.join(d, "policy", f"extra_state_world_size_16_rank_{r}.pt"), "wb").close()
+    assert not is_complete(d)
+
+
+def test_empty_or_absent_directories(tmp_path) -> None:
+    d = write_ckpt(tmp_path, 80, 8, [])
+    assert not is_complete(d) and missing_ranks(d) is None
+    assert "NO SHARDS" in describe(d)
+    absent = os.path.join(str(tmp_path), "global_step_999")
+    assert scan_policy_shards(os.path.join(absent, "policy")) == (None, set())
+
+
+def test_mixed_world_sizes_fail_closed(tmp_path) -> None:
+    d = write_ckpt(tmp_path, 10, 8, range(8))
+    for r in range(3):
+        open(os.path.join(d, "policy", f"model_world_size_32_rank_{r}.pt"), "wb").close()
+    assert not is_complete(d)
+
+
+def test_newest_complete_step_skips_a_partial_latest(tmp_path) -> None:
+    write_ckpt(tmp_path, 80, 8, range(8))
+    write_ckpt(tmp_path, 90, 8, range(4))
+    assert newest_complete_step(str(tmp_path)) == 80
diff --git a/skyrl-train/tests/cpu/test_fill_unscored_rewards.py b/skyrl-train/tests/cpu/test_fill_unscored_rewards.py
new file mode 100644
index 00000000..735954df
--- /dev/null
+++ b/skyrl-train/tests/cpu/test_fill_unscored_rewards.py
@@ -0,0 +1,105 @@
+"""A rollout its env could not score (reward NaN) trains on nothing and moves no other rollout.
+
+`RayPPOTrainer._fill_unscored_rewards` gives it its group's mean scored reward. These tests pin the
+fill itself, and that under Dr. GRPO the filled rollout's advantage is 0 while every scored
+rollout's advantage equals what it would be had the unscored one never been in the group.
+"""
+
+from __future__ import annotations
+
+import math
+import types
+
+import numpy as np
+import pytest
+import torch
+
+from skyrl_train.trainer import RayPPOTrainer
+from skyrl_train.utils.ppo_utils import compute_grpo_outcome_advantage
+
+NAN = float("nan")
+
+
+def fill(rewards: list, uids: list[str]) -> tuple[list, dict]:
+    """Run the trainer's fill on a stub; returns the rewards and the metrics it wrote."""
+    stub = types.SimpleNamespace(all_metrics={})
+    out = RayPPOTrainer._fill_unscored_rewards(stub, {"rewards": list(rewards)}, uids)
+    return out["rewards"], stub.all_metrics
+
+
+def advantages(rewards: list[float], uids: list[str]) -> torch.Tensor:
+    """Dr. GRPO advantages (no std normalisation), one scalar per rollout."""
+    token_rewards = torch.zeros(len(rewards), 3)
+    token_rewards[:, -1] = torch.tensor(rewards)
+    adv, _ = compute_grpo_outcome_advantage(
+        token_level_rewards=token_rewards,
+        response_mask=torch.ones(len(rewards), 3),
+        index=np.array(uids),
+        grpo_norm_by_std=False,
+    )
+    return adv[:, -1]
+
+
+def test_unscored_rollouts_take_their_group_mean() -> None:
+    rewards, metrics = fill([1.0, NAN, 0.0, 0.5, NAN, 0.5], ["a", "a", "a", "b", "b", "b"])
+    assert rewards == [1.0, 0.5, 0.0, 0.5, 0.5, 0.5]
+    assert metrics == {"reward/unscored_frac": pytest.approx(2 / 6)}
+
+
+def test_a_group_with_nothing_scored_gets_zero() -> None:
+    rewards, _ = fill([NAN, NAN, 0.7, 0.1], ["a", "a", "b", "b"])
+    assert rewards == [0.0, 0.0, 0.7, 0.1]
+
+
+def test_scored_batches_pass_through() -> None:
+    rewards, metrics = fill([0.2, 0.9], ["a", "a"])
+    assert rewards == [0.2, 0.9]
+    assert metrics == {"reward/unscored_frac": 0.0}
+
+
+def test_token_level_rewards_are_filled_on_their_totals() -> None:
+    """batched=false returns token lists; a NaN in one must not survive to the advantages."""
+    rewards, metrics = fill([[0.0, 0.0, 1.0], [0.0, NAN], [0.0, 0.5, 0.0, 0.0]], ["a", "a", "a"])
+    assert rewards == [[0.0, 0.0, 1.0], [0.0, 0.75], [0.0, 0.5, 0.0, 0.0]]
+    assert metrics == {"reward/unscored_frac": pytest.approx(1 / 3)}
+    assert not any(math.isnan(r) for row in rewards for r in row)
+
+
+def test_token_level_filled_rollout_has_zero_advantage() -> None:
+    """The filled trajectory's total is its group's mean, so its Dr. GRPO advantage is 0."""
+    raw = [[0.0, 1.0], [0.0, NAN], [0.0, 0.2], [0.0, 0.6]]
+    filled, _ = fill(raw, ["a"] * 4)
+    got = advantages([sum(r) for r in filled], ["a"] * 4)
+    assert abs(float(got[1])) < 1e-6
+    want = advantages([1.0, 0.2, 0.6], ["a"] * 3)
+    assert torch.allclose(got[[0, 2, 3]], want, atol=1e-6)
+
+
+def test_a_run_with_its_reward_source_down_stops(monkeypatch: pytest.MonkeyPatch, tmp_path) -> None:
+    """Over SKYRL_MAX_UNSCORED_FRAC for SKYRL_MAX_UNSCORED_STEPS steps raises and writes the stop file; a good step resets."""
+    monkeypatch.setenv("SKYRL_MAX_UNSCORED_FRAC", "0.5")
+    monkeypatch.setenv("SKYRL_MAX_UNSCORED_STEPS", "3")
+    stub = types.SimpleNamespace(all_metrics={})
+    for _ in range(2):
+        RayPPOTrainer._fill_unscored_rewards(stub, {"rewards": [NAN, NAN, 0.1]}, ["a", "a", "a"])
+    RayPPOTrainer._fill_unscored_rewards(stub, {"rewards": [0.2, 0.3, 0.1]}, ["a", "a", "a"])
+    for _ in range(2):
+        RayPPOTrainer._fill_unscored_rewards(stub, {"rewards": [NAN, NAN, 0.1]}, ["a", "a", "a"])
+    stop = tmp_path / "STOP_unscored"
+    monkeypatch.setenv("SKYRL_STOP_FILE", str(stop))
+    with pytest.raises(RuntimeError, match="consecutive steps"):
+        RayPPOTrainer._fill_unscored_rewards(stub, {"rewards": [NAN, NAN, 0.1]}, ["a", "a", "a"])
+    assert "consecutive steps" in stop.read_text()
+
+
+def test_filled_rollout_has_zero_advantage_and_the_rest_are_unchanged() -> None:
+    raw = [1.0, NAN, 0.2, 0.6, 0.0, 0.5, NAN, 1.0]
+    uids = ["a"] * 4 + ["b"] * 4
+    filled, _ = fill(raw, uids)
+    got = advantages(filled, uids)
+
+    keep = [i for i, r in enumerate(raw) if not math.isnan(r)]
+    want = advantages([raw[i] for i in keep], [uids[i] for i in keep])
+    assert torch.allclose(got[keep], want, atol=1e-6)
+    unscored = [i for i, r in enumerate(raw) if math.isnan(r)]
+    assert torch.allclose(got[unscored], torch.zeros(len(unscored)), atol=1e-6)
diff --git a/skyrl-train/tests/cpu/test_resume_start_epoch.py b/skyrl-train/tests/cpu/test_resume_start_epoch.py
