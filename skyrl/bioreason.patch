+    def _fill_unscored_rewards(self, generator_output: GeneratorOutput, uids: List[str]) -> GeneratorOutput:
+        """Give every rollout its env could not score (reward NaN) its group's mean scored reward.
+
+        An env returns NaN when the reward is unavailable rather than low -- a judge call that failed,
+        say. A 0 there would be a verdict, and an outage would teach the policy that everything it
+        wrote was worthless. At its group's mean a rollout's GRPO advantage is 0 up to float rounding,
+        and the others' are unchanged because the mean they are centred on does not move (under
+        `grpo_norm_by_std` the smaller std does rescale them). A group with nothing scored gets 0
+        throughout, i.e. no gradient. Dropping the rollouts instead would break the group size and
+        the dp divisibility the batch relies on.
+
+        Token-level rewards (the per-trajectory agent loop, `generator.batched=false`) are handled
+        the same way on each trajectory's total: a trajectory holding a NaN becomes zeros with its
+        group's mean total at the NaN's position. A NaN left in place would make the group's
+        advantages, the loss and the grad norm NaN, so one unscored rollout would cost the whole step.
+
+        A run whose judge has gone away (budget exhausted, endpoint down) would otherwise go on
+        "training" on zeros; SKYRL_MAX_UNSCORED_FRAC over SKYRL_MAX_UNSCORED_STEPS consecutive steps
+        ends it instead.
+
+        Args:
+            generator_output: The batch, one scalar reward or one token-level list per rollout.
+            uids: Prompt id per rollout; rollouts sharing a uid form one group.
+
+        Returns:
+            The same output with no NaN reward left. `reward/unscored_frac` records the share filled.
+
+        Raises:
+            RuntimeError: Too many rollouts unscored for too many consecutive steps.
+        """
+        rewards = generator_output["rewards"]
+        if not rewards:
+            return generator_output
+        token_level = isinstance(rewards[0], list)
+        totals = [sum(r) for r in rewards] if token_level else list(rewards)
+        scored: Dict[str, List[float]] = defaultdict(list)
+        for uid, total in zip(uids, totals):
+            if not math.isnan(total):
+                scored[uid].append(float(total))
+        unscored = 0
+        filled = []
+        for uid, reward, total in zip(uids, rewards, totals):
+            if not math.isnan(total):
+                filled.append(reward)
+                continue
+            unscored += 1
+            group = scored[uid]
+            mean = sum(group) / len(group) if group else 0.0
