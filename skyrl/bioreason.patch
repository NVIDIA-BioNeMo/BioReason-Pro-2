diff --git a/skyrl-train/tests/cpu/utils/test_drgrpo_divisor.py b/skyrl-train/tests/cpu/utils/test_drgrpo_divisor.py
new file mode 100644
index 00000000..ad8ae1a5
--- /dev/null
+++ b/skyrl-train/tests/cpu/utils/test_drgrpo_divisor.py
@@ -0,0 +1,83 @@
+"""Resolution of the Dr. GRPO loss divisor (`trainer.algorithm.max_seq_len`).
+
+`seq_mean_token_sum_norm` divides each sequence's token-sum by this constant
+(`ppo_utils.reduce_loss`). Dr. GRPO only requires the divisor be constant, so the legacy
+derivation `max_input_length + max_generate_length` is unbiased -- but it couples the loss
+scale to `max_prompt_length`, so raising the prompt budget silently rescales the loss with
+nothing in the config connecting the two. These tests pin the explicit override that breaks
+that coupling, and pin the legacy derivation as the untouched default.
+"""
+
+import pytest
+from omegaconf import DictConfig
+
+from skyrl_train.config.utils import get_default_config
+from skyrl_train.utils.utils import validate_cfg
+
+
+def _cfg(max_prompt_length: int = 24576, max_generate_length: int = 4096, max_seq_len=None) -> DictConfig:
+    cfg = get_default_config()
+    # the default logger is wandb, which validate_cfg gates on WANDB_API_KEY being present
+    cfg.trainer.logger = "tensorboard"
+    cfg.trainer.algorithm.loss_reduction = "seq_mean_token_sum_norm"
+    cfg.trainer.max_prompt_length = max_prompt_length
+    # `generator.max_input_length` interpolates `trainer.max_prompt_length` in the base yaml,
+    # but get_default_config() returns it already resolved, so it must be set explicitly --
+    # validate_generator_cfg asserts the two are equal for single-turn generation.
+    cfg.generator.max_input_length = max_prompt_length
+    cfg.generator.sampling_params.max_generate_length = max_generate_length
+    cfg.trainer.algorithm.max_seq_len = max_seq_len
+    return cfg
+
+
+def test_default_keeps_legacy_derivation():
+    # An unset value must resolve exactly as it did before the override existed.
+    cfg = _cfg(max_seq_len=None)
+    validate_cfg(cfg)
+    assert cfg.trainer.algorithm.max_seq_len == 24576 + 4096
+
+
+def test_explicit_value_wins():
+    cfg = _cfg(max_seq_len=4096)
+    validate_cfg(cfg)
+    assert cfg.trainer.algorithm.max_seq_len == 4096
+
+
+def test_explicit_value_decouples_from_prompt_length():
+    """The actual regression: prompt budget must not move the loss scale.
+
+    `generator.max_input_length` interpolates `trainer.max_prompt_length`, so under the
+    legacy derivation a data-coverage change to the prompt budget rescales every gradient.
+    """
+    resolved = []
+    for prompt_len in (4096, 24576):
+        cfg = _cfg(max_prompt_length=prompt_len, max_seq_len=4096)
+        validate_cfg(cfg)
+        resolved.append(cfg.trainer.algorithm.max_seq_len)
+    assert resolved == [4096, 4096]
+
+    # ... and confirm the coupling is real when the override is absent, so this test would
+    # fail loudly if the default branch were ever silently changed to a constant.
+    legacy = []
+    for prompt_len in (4096, 24576):
+        cfg = _cfg(max_prompt_length=prompt_len, max_seq_len=None)
+        validate_cfg(cfg)
+        legacy.append(cfg.trainer.algorithm.max_seq_len)
+    assert legacy == [8192, 28672]
+
+
+def test_explicit_value_is_coerced_to_int():
+    # YAML/CLI overrides arrive as strings; the divisor is used in a tensor division.
+    cfg = _cfg(max_seq_len="4096")
+    validate_cfg(cfg)
+    assert cfg.trainer.algorithm.max_seq_len == 4096
+    assert isinstance(cfg.trainer.algorithm.max_seq_len, int)
+
+
+@pytest.mark.parametrize("reduction", ["token_mean", "sequence_mean"])
+def test_other_reductions_still_resolve(reduction):
+    # `max_seq_len` is unused by these, but resolution must not raise for them.
+    cfg = _cfg(max_seq_len=4096)
+    cfg.trainer.algorithm.loss_reduction = reduction
+    validate_cfg(cfg)
+    assert cfg.trainer.algorithm.max_seq_len == 4096
diff --git a/skyrl-train/tests/cpu/utils/test_onpolicy_exact_ratio.py b/skyrl-train/tests/cpu/utils/test_onpolicy_exact_ratio.py
new file mode 100644
index 00000000..d34f2f47
--- /dev/null
+++ b/skyrl-train/tests/cpu/utils/test_onpolicy_exact_ratio.py
@@ -0,0 +1,127 @@
+"""The exact-on-policy ratio gate.
+
+With `mini == train` and one epoch there is exactly one optimizer step per batch, so the policy
+does not move between the fwd_logprobs pass and the training forward: the PPO ratio should be 1
+and the clip inert. In practice the two passes are the same weights disagreeing numerically, so
+the clip fires on noise. The gate removes that by taking the denominator from the training forward.
+
+These tests pin the three things that make it safe: it really does drive the ratio to exactly 1 (so
+the clip cannot fire), it leaves the GRADIENT equal to the vanilla policy gradient, and
+`validate_cfg` refuses every shape where the substitution would erase a REAL off-policy ratio.
+"""
+
+from __future__ import annotations
+
+import pytest
+import torch
+from omegaconf import DictConfig, OmegaConf
+
+from skyrl_train.config.utils import get_default_config
+from skyrl_train.utils.ppo_utils import ppo_policy_loss
+from skyrl_train.utils.utils import validate_cfg
+
+
+def _loss_cfg(**over) -> DictConfig:
+    base = dict(
+        policy_loss_type="regular",
+        loss_reduction="token_mean",
+        eps_clip_low=0.1,
+        eps_clip_high=0.1,
+        clip_ratio_c=3.0,
+        use_tis=False,
+        max_seq_len=4096,
+        onpolicy_exact_ratio=False,
+    )
+    base.update(over)
+    return OmegaConf.create(base)
+
+
+def _noisy_inputs(seed: int = 0):
+    """log_probs and a DELIBERATELY mismatched old_log_probs, as two forwards would produce."""
+    g = torch.Generator().manual_seed(seed)
+    log_probs = torch.randn(4, 16, generator=g, requires_grad=True)
+    # noise well past eps=0.1 on a good fraction of tokens
+    old = (log_probs.detach() + 0.3 * torch.randn(4, 16, generator=g)).detach()
+    adv = torch.randn(4, 16, generator=g)
+    mask = torch.ones(4, 16)
+    return log_probs, old, adv, mask
+
+
+def test_off_the_gate_clips_on_noise_alone():
+    """Baseline: mismatched old_log_probs make the clip fire even though the policy never moved."""
+    lp, old, adv, mask = _noisy_inputs()
+    _, clip_ratio = ppo_policy_loss(lp, old, adv, _loss_cfg(), loss_mask=mask)
+    assert clip_ratio > 0.1, clip_ratio  # the artefact this gate exists to remove
+
+
+def test_gate_drives_clip_ratio_to_zero():
+    lp, old, adv, mask = _noisy_inputs()
+    _, clip_ratio = ppo_policy_loss(lp, old, adv, _loss_cfg(onpolicy_exact_ratio=True), loss_mask=mask)
+    assert clip_ratio == 0.0
+
+
+@pytest.mark.parametrize("eps", [0.05, 0.1, 0.2, 0.28])
+def test_gate_makes_eps_INERT(eps):
+    """The point of the change: with the ratio exactly 1, eps cannot affect the loss at all."""
+    lp, old, adv, mask = _noisy_inputs()
+    cfg = _loss_cfg(onpolicy_exact_ratio=True, eps_clip_low=eps, eps_clip_high=eps)
+    loss, clip_ratio = ppo_policy_loss(lp, old, adv, cfg, loss_mask=mask)
+    ref, _ = ppo_policy_loss(
+        lp, old, adv, _loss_cfg(onpolicy_exact_ratio=True, eps_clip_low=0.1, eps_clip_high=0.1), loss_mask=mask
+    )
+    assert clip_ratio == 0.0
+    assert torch.allclose(loss, ref)
+
+
+def test_gate_yields_the_vanilla_policy_gradient():
+    """grad should be -A * grad log_probs, i.e. what one-update-per-batch already implies."""
+    lp, old, adv, mask = _noisy_inputs()
+    loss, _ = ppo_policy_loss(lp, old, adv, _loss_cfg(onpolicy_exact_ratio=True), loss_mask=mask)
+    loss.backward()
+    got = lp.grad.clone()
+
+    lp2 = lp.detach().clone().requires_grad_(True)
+    (-(adv * lp2) * mask).sum().div(mask.sum()).backward()
+    assert torch.allclose(got, lp2.grad, atol=1e-6)
+
+
+def test_gate_is_off_by_default():
+    lp, old, adv, mask = _noisy_inputs()
+    _, gated = ppo_policy_loss(lp, old, adv, _loss_cfg(onpolicy_exact_ratio=True), loss_mask=mask)
+    _, default = ppo_policy_loss(lp, old, adv, _loss_cfg(), loss_mask=mask)
+    assert gated == 0.0 and default > 0.1
+
+
+class TestValidateCfgRefusals:
+    def _cfg(self, **over):
+        cfg = get_default_config()
+        cfg.trainer.logger = "tensorboard"
+        cfg.generator.max_input_length = cfg.trainer.max_prompt_length
+        cfg.trainer.algorithm.onpolicy_exact_ratio = True
+        cfg.trainer.train_batch_size = 32
+        cfg.trainer.policy_mini_batch_size = 32
+        cfg.trainer.update_epochs_per_batch = 1
+        cfg.trainer.algorithm.use_tis = False
+        for k, v in over.items():
+            OmegaConf.update(cfg, k, v)
+        return cfg
+
+    def test_accepts_the_one_update_shape(self):
+        validate_cfg(self._cfg())
+
+    def test_refuses_mini_smaller_than_train(self):
+        with pytest.raises(ValueError, match="policy_mini_batch_size == train_batch_size"):
+            validate_cfg(self._cfg(**{"trainer.policy_mini_batch_size": 16}))
+
+    def test_refuses_multiple_epochs(self):
+        with pytest.raises(ValueError, match="update_epochs_per_batch == 1"):
+            validate_cfg(self._cfg(**{"trainer.update_epochs_per_batch": 2}))
+
+    def test_refuses_tis(self):
+        with pytest.raises(ValueError, match="incompatible with use_tis"):
+            validate_cfg(self._cfg(**{"trainer.algorithm.use_tis": True}))
+
+    def test_default_off_needs_no_shape(self):
+        cfg = self._cfg(**{"trainer.policy_mini_batch_size": 16})
+        cfg.trainer.algorithm.onpolicy_exact_ratio = False
+        validate_cfg(cfg)
diff --git a/skyrl-train/tests/cpu/utils/test_skip_old_logprob_pass.py b/skyrl-train/tests/cpu/utils/test_skip_old_logprob_pass.py
new file mode 100644
index 00000000..7549cbcf
--- /dev/null
+++ b/skyrl-train/tests/cpu/utils/test_skip_old_logprob_pass.py
@@ -0,0 +1,206 @@
+"""Skipping the policy's fwd_logprobs pass leaves the loss and its gradient exactly as they were.
+
+Under `onpolicy_exact_ratio` the ratio's denominator is the training forward's own detached
+logprob, so the skipped pass's output reaches no loss term. These tests pin that it reaches none
+(identical loss and gradient for any old_log_probs), that the trainer really skips the policy
+forward, that the gap parts reassemble the same token-weighted mean and the trainer reports their
+ratio under the old name, and that `validate_cfg` refuses every config where something would still
+read the skipped pass or the gap would measure something else.
+"""
+
+from __future__ import annotations
+
+import types
+
+import pytest
+import torch
+from omegaconf import OmegaConf
+
+from skyrl_train import trainer as trainer_module
+from skyrl_train.config.utils import get_default_config
+from skyrl_train.trainer import RayPPOTrainer
+from skyrl_train.training_batch import TrainingInputBatch, TrainingOutputBatch
+from skyrl_train.utils.ppo_utils import ppo_policy_loss
+from skyrl_train.utils.utils import validate_cfg
+from skyrl_train.workers.worker_utils import reduce_metrics, rollout_gap_parts
+
+
+def loss_cfg(**over):
+    """The shipping loss config: dual_clip, Dr. GRPO reduction, exact ratio on."""
+    base = dict(
+        policy_loss_type="dual_clip",
+        loss_reduction="seq_mean_token_sum_norm",
+        eps_clip_low=0.2,
+        eps_clip_high=0.28,
+        clip_ratio_c=3.0,
+        use_tis=False,
+        max_seq_len=4096,
+        onpolicy_exact_ratio=True,
+    )
+    base.update(over)
+    return OmegaConf.create(base)
+
+
+def test_exact_ratio_loss_and_grad_ignore_old_logprobs() -> None:
+    """The skipped pass's zeros give the loss and gradient real logprobs give: the vanilla loss at ratio 1."""
+    g = torch.Generator().manual_seed(0)
+    base = torch.randn(4, 16, generator=g)
+    advantages = torch.randn(4, 16, generator=g)
+    mask = (torch.rand(4, 16, generator=g) > 0.2).float()
+    real_old = base + 0.3 * torch.randn(4, 16, generator=g)
+
+    def run(old_log_probs, exact: bool = True):
+        log_probs = base.clone().requires_grad_(True)
+        old = log_probs.detach() if old_log_probs is None else old_log_probs
+        loss, clip = ppo_policy_loss(log_probs, old, advantages, loss_cfg(onpolicy_exact_ratio=exact), loss_mask=mask)
+        loss.backward()
+        return loss.detach(), log_probs.grad, clip
+
+    want = run(real_old)
+    for got in (run(torch.zeros_like(real_old)), run(None, exact=False)):
+        assert torch.equal(want[0], got[0])
+        assert torch.equal(want[1], got[1])
+        assert want[2] == got[2] == 0.0
+
+
+def test_gap_parts_reassemble_the_token_weighted_mean() -> None:
+    """Sum and count averaged over micro-batches and ranks, then divided, equal the batch-wide mean."""
+    g = torch.Generator().manual_seed(1)
+    train = torch.randn(8, 10, generator=g)
+    rollout = train + 0.05 * torch.randn(8, 10, generator=g)
+    # Unequal response lengths, so a mean of per-sequence means would differ from the token mean.
+    mask = torch.zeros(8, 10)
+    for row, length in enumerate([10, 2, 7, 1, 10, 4, 3, 9]):
+        mask[row, :length] = 1.0
+    batch_mean = (train - rollout)[mask > 0].abs().mean().item()
+
+    per_micro = [
+        dict(
+            zip(
+                ("_lpgap_sum", "_lpgap_count"), rollout_gap_parts(train[i : i + 1], rollout[i : i + 1], mask[i : i + 1])
+            )
+        )
+        for i in range(8)
+    ]
+    ranks = [per_micro[:4], per_micro[4:]]
+    # all_reduce(mean) over 2 ranks at each micro-step, then reduce_metrics over micro-steps.
+    reduced_steps = [{k: (a[k] + b[k]) / 2 for k in a} for a, b in zip(*ranks)]
+    metrics = reduce_metrics({k: [s[k] for s in reduced_steps] for k in reduced_steps[0]})
+    assert metrics["_lpgap_sum"] / metrics["_lpgap_count"] == pytest.approx(batch_mean, rel=1e-6)
+
+
+class RefusePolicyCalls:
+    """Stands in for the policy actor group; any call means the pass was not skipped."""
+
+    def __getattr__(self, name):
+        raise AssertionError(f"the skipped pass still called policy_model.{name}")
+
+
+def test_trainer_skips_the_policy_forward(monkeypatch) -> None:
+    """With the flag on, fwd_logprobs never touches the policy and writes zeros of the response shape."""
+    cfg = get_default_config()
+    cfg.trainer.algorithm.skip_old_logprob_pass = True
+    cfg.generator.sampling_params.logprobs = 0
+    stub = types.SimpleNamespace(
+        cfg=cfg, colocate_all=True, critic_model=None, ref_model=None, policy_model=RefusePolicyCalls(), all_metrics={}
+    )
+    data = TrainingInputBatch(
+        {
+            "sequences": torch.randint(0, 50, (4, 12)),
+            "attention_mask": torch.ones(4, 12, dtype=torch.long),
+            "loss_mask": torch.ones(4, 5),
+            "rollout_logprobs": torch.randn(4, 5),
+        }
+    )
+    data.metadata = {"response_length": 5}
+    monkeypatch.setattr(trainer_module.ray, "get", lambda refs: refs)
+    out = RayPPOTrainer.fwd_logprobs_values_reward(stub, data)
+    assert torch.equal(out["action_log_probs"], torch.zeros(4, 5))
+    assert "policy/rollout_train_logprob_abs_diff_mean" not in stub.all_metrics
+
+
+class StatusPolicy:
+    """Stands in for the policy actor group, returning one reduced train status from ppo_train."""
+
+    def __init__(self, status: dict) -> None:
+        self.status = status
+
+    def backload_to_gpu(self) -> None:
+        pass
+
+    def async_run_ray_method(self, dispatch: str, method: str, *args) -> list:
+        if method != "ppo_train":
+            return []
+        out = TrainingOutputBatch()
+        out.metadata = {"train_status": dict(self.status)}
+        return [out]
+
+
+@pytest.mark.parametrize("count", [40.0, 0.0])
+def test_trainer_reports_the_gap_as_sum_over_count(monkeypatch, count: float) -> None:
+    """The private parts never reach the logger; their ratio does, under the flag-off metric's name,
+    and only when there were rollout logprobs to compare."""
+    status = {"policy_loss": 0.1, "_lpgap_sum": 0.6 if count else 0.0, "_lpgap_count": count}
+    stub = types.SimpleNamespace(
+        global_step=1,
+        colocate_all=True,
+        critic_model=None,
+        policy_model=StatusPolicy(status),
+        all_metrics={},
+        all_timings={},
+        _balance_dp_tokens=lambda data: data,
+    )
+    data = TrainingInputBatch({"sequences": torch.zeros(2, 3, dtype=torch.long)})
+    data.metadata = {}
+    monkeypatch.setattr(trainer_module.ray, "get", lambda refs: refs)
+    RayPPOTrainer.train_critic_and_policy(stub, data)
+    want = {"policy/policy_loss": 0.1}
+    if count:
+        want["policy/rollout_train_logprob_abs_diff_mean"] = 0.6 / 40.0
+    assert stub.all_metrics == want
+
+
+class TestRefusals:
+    def cfg(self, **over):
+        """A config the skip accepts: the shipping shape with the exact ratio on."""
+        cfg = get_default_config()
+        cfg.trainer.logger = "tensorboard"
+        cfg.generator.max_input_length = cfg.trainer.max_prompt_length
+        cfg.trainer.train_batch_size = 32
+        cfg.trainer.policy_mini_batch_size = 32
+        cfg.trainer.update_epochs_per_batch = 1
+        cfg.trainer.strategy = "fsdp2"
+        cfg.trainer.algorithm.onpolicy_exact_ratio = True
+        cfg.trainer.algorithm.policy_loss_type = "dual_clip"
+        cfg.trainer.algorithm.skip_old_logprob_pass = True
+        for key, value in over.items():
+            OmegaConf.update(cfg, key, value)
+        return cfg
+
+    def test_accepts_the_shipping_shape(self) -> None:
+        validate_cfg(self.cfg())
+
+    def test_refuses_without_the_exact_ratio(self) -> None:
+        with pytest.raises(ValueError, match="requires onpolicy_exact_ratio"):
+            validate_cfg(self.cfg(**{"trainer.algorithm.onpolicy_exact_ratio": False}))
+
+    def test_refuses_a_loss_that_reads_old_logprobs(self) -> None:
+        with pytest.raises(ValueError, match="regular or dual_clip"):
+            validate_cfg(self.cfg(**{"trainer.algorithm.policy_loss_type": "gspo"}))
+
+    def test_refuses_kl_in_reward(self) -> None:
+        with pytest.raises(ValueError, match="use_kl_in_reward"):
+            validate_cfg(
+                self.cfg(**{"trainer.algorithm.use_kl_in_reward": True, "trainer.algorithm.use_kl_loss": False})
+            )
+
