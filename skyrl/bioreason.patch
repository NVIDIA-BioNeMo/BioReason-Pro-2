@@ -0,0 +1,95 @@
+"""GRPO reward env for BioReason-Pro protein-function prediction.
+
+A thin adapter: the reward is an LLM judge's score from ``bioreason2.rl.judge_reward``. A judge
+failure returns NaN, which the trainer replaces with the group mean (zero advantage). With
+``SKYRL_JUDGE_GROUP_SIZE`` set (the GRPO group size), a group's rollouts are judged together in one
+call: each env's step waits at ``judge_group_member``'s per-protein barrier, so ``max_env_workers``
+must be at least the group size (512 runs a whole step's groups at once).
+"""
+
+import math
+from typing import Any, Dict, List
+
+import numpy as np
+
+from skyrl_gym.envs.base_text_env import BaseTextEnv, BaseTextEnvStepOutput
+
+from bioreason2.rl import judge
+from bioreason2.rl.judge_reward import GROUP_SIZE, judge_go_reward, judge_group_member
+from bioreason2.rl.reward import ground_truth
+
+
+class GoFunctionEnv(BaseTextEnv):
+    """Scores one generation with the LLM judge."""
+
+    def __init__(self, env_config: Any = None, extras: Dict[str, Any] = None):
+        """
+        Args:
+            env_config: Unused; present for the SkyRL env interface.
+            extras: Must carry ``extra_info`` with the protein's labels (``go_{mf,bp,cc}``,
+                ``go_*_tier2``, ``scored_aspects``), as ``bioreason2.rl.build_dataset`` writes it,
+                and the judge's inputs ``question`` and ``judge_truth``
+                (``bioreason2.rl.add_judge_fields``).
+
+        Raises:
+            ValueError: The row has no labels, no scorable ground truth, or lacks the judge's
+                inputs (a judge without the question or the truth can invert the reward).
+        """
+        super().__init__()
+        self.labels = (extras or {}).get("extra_info") or {}
+        if "protein_id" not in self.labels:
+            raise ValueError("extras.extra_info must carry the protein's labels (protein_id, go_*)")
+        truth, _aspects = ground_truth(self.labels)
+        if not truth:
+            raise ValueError(f"{self.labels['protein_id']}: no scorable ground truth; drop it at dataset build")
+        missing = [k for k in ("question", "judge_truth") if not self.labels.get(k)]
+        if missing:
+            raise ValueError(f"{self.labels['protein_id']}: the judge needs extra_info {missing}")
+        self.last_judge = None
+
+    def step(self, action: str) -> BaseTextEnvStepOutput:
+        """Score one rollout.
+
+        Args:
+            action: The model's completion.
+
+        Returns:
+            A terminal step; the reward is NaN when the judge could not score it.
+        """
+        truth = {**self.labels, **(self.labels.get("judge_truth") or {})}
+        if GROUP_SIZE > 0:
+            self.last_judge = judge_group_member(action, self.labels["question"], truth, self.labels)
+        else:
+            self.last_judge = judge_go_reward(action, self.labels["question"], truth, self.labels)
+        metadata = {"protein_id": self.labels["protein_id"], "parsed": self.last_judge.parsed,
+                    "n_predicted": self.last_judge.n_predicted}
+        return BaseTextEnvStepOutput(observations=[], reward=self.last_judge.reward, done=True, metadata=metadata)
+
+    def get_metrics(self) -> Dict[str, Any]:
+        """Per-episode diagnostics; SkyRL calls this after the episode ends."""
+        if self.last_judge is None:
+            return {}
+        j = self.last_judge
+        metrics = {"parsed": float(j.parsed), "n_predicted": float(j.n_predicted),
+                   "length_factor": j.length_factor, "judge_called": float(j.called),
+                   "judge_failed": float(j.called and j.score is None)}
+        if j.called:
+            metrics["judge_latency_s"] = j.latency_s
+        if j.score is not None:
+            metrics["judge_score"] = j.score
+        if j.position is not None:
+            metrics["judge_group_n"] = float(j.group_n)
+        if not math.isnan(j.reward):
+            metrics["reward"] = j.reward
+        metrics.update(judge.stats())
+        return metrics
+
+    @staticmethod
+    def aggregate_metrics(metrics: List[Dict[str, Any]]) -> Dict[str, Any]:
+        """Average each metric over the rollouts that report it.
+
+        A metric is absent for a rollout that never produced it (no judge call, no usable score),
+        so it is averaged over the rollouts that have it rather than diluted by zeros.
+        """
+        keys = sorted({k for m in metrics for k in m})
+        return {k: float(np.mean([m[k] for m in metrics if k in m])) for k in keys}
