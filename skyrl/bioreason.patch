index 00000000..31b62501
--- /dev/null
+++ b/skyrl-train/tests/cpu/test_resume_start_epoch.py
@@ -0,0 +1,67 @@
+"""A resumed run trains exactly its planned number of updates, with a real StatefulDataLoader."""
+
+import pytest
+import torch
+from torchdata.stateful_dataloader import StatefulDataLoader
+
+from skyrl_train.utils.trainer_utils import resume_start_epoch
+
+STEPS_PER_EPOCH = 5
+
+
+def loader() -> StatefulDataLoader:
+    """A seeded, shuffled loader of STEPS_PER_EPOCH batches, built as the trainer builds its own."""
+    generator = torch.Generator()
+    generator.manual_seed(23)
+    return StatefulDataLoader(list(range(2 * STEPS_PER_EPOCH)), batch_size=2, shuffle=True, drop_last=True,
+                              generator=generator)
+
+
+def updates(state: dict | None, completed: int, epochs: int) -> int:
+    """How many batches the trainer's epoch loop consumes after resuming.
+
+    Args:
+        state: The saved dataloader state, or None for a fresh run.
+        completed: Updates already applied.
+        epochs: Planned epochs.
+
+    Returns:
+        Batches trained after the resume.
+    """
+    data = loader()
+    if state is not None:
+        data.load_state_dict(state)
+    trained = 0
+    epoch = resume_start_epoch(completed, len(data))
+    while epoch < epochs:  # the trainer's loop
+        stepped = False
+        for _ in data:
+            stepped = True
+            trained += 1
+        if stepped or len(data) == 0:
+            epoch += 1
+    return trained
+
+
+@pytest.mark.parametrize("completed", [0, 3, 5, 7, 10])
+def test_resume_trains_the_rest_of_the_plan(completed: int) -> None:
+    """Resume after `completed` updates of a 2-epoch plan, the state saved inside the step as the trainer
+    saves it (an epoch boundary included): exactly the remaining updates run."""
+    epochs = 2
+    data = loader()
+    seen = 0
+    state = None
+    for _ in range(epochs):
+        for _ in data:
+            seen += 1
+            if seen == completed:
+                state = data.state_dict()
+                break
+        if seen == completed:
+            break
+    assert updates(state if completed else None, completed, epochs) == epochs * STEPS_PER_EPOCH - completed
+
+
+def test_complete_run_trains_nothing() -> None:
+    """A run resumed with every update done does not start another epoch."""
+    assert resume_start_epoch(2 * STEPS_PER_EPOCH, STEPS_PER_EPOCH) == 2
