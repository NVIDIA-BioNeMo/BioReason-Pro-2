@@ -0,0 +1,26 @@
+import pytest
+from transformers.models.qwen3_5 import modeling_qwen3_5
+
+# transformers 5.12 binds Qwen3.5's gated-delta-net kernels to each layer at construction: the
+# causal-conv1d and fla CUDA kernels whenever those packages import, else the torch fallbacks. An env
+# that ships the kernels therefore builds CPU test models whose forward calls CUDA-only code. The module-level names below are what the layers read, so clearing
+# them before a model is built gives the torch path these CPU tests are written for. Later
+# transformers pick the kernel per call instead and define none of these names, so there is nothing
+# to clear and the fixture does nothing.
+GDN_KERNELS = (
+    "causal_conv1d_fn",
+    "causal_conv1d_update",
+    "chunk_gated_delta_rule",
+    "fused_recurrent_gated_delta_rule",
+    "FusedRMSNormGated",
+)
+
+
+@pytest.fixture
+def torch_gdn(monkeypatch) -> None:
+    """Build Qwen3.5 test models on the torch gated-delta-net path, whatever kernels are installed."""
+    if not hasattr(modeling_qwen3_5, "is_fast_path_available"):
+        return
+    for name in GDN_KERNELS:
+        monkeypatch.setattr(modeling_qwen3_5, name, None)
+    monkeypatch.setattr(modeling_qwen3_5, "is_fast_path_available", False)
