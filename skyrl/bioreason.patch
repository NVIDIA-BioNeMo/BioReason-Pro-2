+def missing_ranks(checkpoint_dir: str) -> list[int] | None:
+    """Ranks that never wrote a shard, or ``None`` if the checkpoint has no shards at all.
+
+    Args:
+        checkpoint_dir: A ``global_step_N`` directory.
+
+    Returns:
+        A sorted list of missing rank ids -- empty when the checkpoint is complete -- or ``None``
+        when nothing recognisable is present (an empty or pruned directory).
+    """
+    world_size, present = scan_policy_shards(os.path.join(checkpoint_dir, "policy"))
+    if world_size is None:
+        return None
+    return sorted(set(range(world_size)) - present)
+
+
+def is_complete(checkpoint_dir: str) -> bool:
+    """True only when every rank ``0..world_size-1`` wrote its model and extra_state shards."""
+    missing = missing_ranks(checkpoint_dir)
+    return missing == []
+
+
+def describe(checkpoint_dir: str) -> str:
+    """One-line human-readable verdict, for logging at the point of refusal."""
+    world_size, present = scan_policy_shards(os.path.join(checkpoint_dir, "policy"))
+    if world_size is None:
+        return f"{checkpoint_dir}: NO SHARDS (empty or pruned)"
+    missing = sorted(set(range(world_size)) - present)
+    if not missing:
+        return f"{checkpoint_dir}: complete ({world_size}/{world_size} ranks)"
+    shown = ",".join(str(r) for r in missing[:8]) + ("..." if len(missing) > 8 else "")
+    return f"{checkpoint_dir}: INCOMPLETE {len(present)}/{world_size} ranks, missing [{shown}]"
+
+
+def newest_complete_step(ckpt_path: str, at_most: int | None = None) -> int | None:
+    """The highest ``global_step_N`` under ``ckpt_path`` whose shards are all present.
+
+    Args:
+        ckpt_path: Directory holding the ``global_step_*`` subdirectories.
+        at_most: If given, ignore steps above this. Used on resume so a repaired marker can only
+            ever move BACKWARD -- never forward past the step the run believed it had reached,
+            which would silently skip training.
+
+    Returns:
+        The step number, or ``None`` when no complete checkpoint exists.
+    """
+    try:
+        entries = os.listdir(ckpt_path)
+    except (FileNotFoundError, NotADirectoryError, PermissionError):
+        return None
+
+    steps: list[int] = []
+    for name in entries:
+        if not name.startswith(GLOBAL_STEP_PREFIX):
+            continue
+        suffix = name[len(GLOBAL_STEP_PREFIX) :]
+        if not suffix.isdigit():
+            continue
+        step = int(suffix)
+        if at_most is not None and step > at_most:
+            continue
+        if is_complete(os.path.join(ckpt_path, name)):
+            steps.append(step)
+    return max(steps) if steps else None
