index 00000000..e3b542d4
--- /dev/null
+++ b/skyrl-train/tests/cpu/models/test_hybrid_detection.py
@@ -0,0 +1,22 @@
+"""Which configs count as hybrid, i.e. carry layers that packing would run across sequence boundaries."""
+
+from __future__ import annotations
+
+from transformers import LlamaConfig, Qwen3_5TextConfig
+
+from skyrl_train.model_wrapper import has_recurrent_layers
+
+
+def test_qwen35_text_config_is_hybrid() -> None:
+    """Qwen3.5's default layout is three gated-delta-net layers per full-attention layer."""
+    assert has_recurrent_layers(Qwen3_5TextConfig(num_hidden_layers=4))
+
+
+def test_qwen35_all_attention_config_is_not_hybrid() -> None:
+    """The check reads the layer types, not the model family."""
+    assert not has_recurrent_layers(Qwen3_5TextConfig(num_hidden_layers=2, layer_types=["full_attention"] * 2))
+
+
+def test_dense_attention_model_is_not_hybrid() -> None:
+    """A plain transformer keeps packing at any micro-batch size."""
+    assert not has_recurrent_layers(LlamaConfig(num_hidden_layers=2))
