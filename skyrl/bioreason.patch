+    def _grpo_group_metrics(generator_output: GeneratorOutput, uids: List[str]) -> Dict[str, float]:
+        """Per-prompt group statistics, the health check for a critic-free algorithm.
+
+        GRPO's advantage is each reward's deviation from its own prompt group's mean, so a group with
+        zero spread contributes no gradient at all while mean reward, loss and entropy still look normal.
+
+        Args:
+            generator_output: The batch, one scalar reward or one token-level list per rollout.
+            uids: Prompt id per rollout; rollouts sharing a uid form one group.
+
+        Returns:
+            Group-level metrics, or an empty dict when no group has two or more rollouts.
+        """
+        rewards = generator_output.get("rewards")
+        if not rewards or not uids:
+            return {}
+
+        groups: Dict[str, List[float]] = defaultdict(list)
+        for uid, reward in zip(uids, rewards):
+            # A token-level reward counts as its sum, as in the GRPO advantage.
+            groups[uid].append(float(sum(reward)) if isinstance(reward, list) else float(reward))
